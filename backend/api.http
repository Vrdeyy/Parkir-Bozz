@baseUrl = http://localhost:3000

### ==========================================
### 1. LOGIN ADMIN
### ==========================================

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "obatkuat1234"
}

###

@token = {{login.response.body.access_token}}

### ==========================================
### 2. CRUD USER
### ==========================================

### 2.1 Buat user petugas 01
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_lengkap": "Petugas Parkir",
  "username": "petugas01",
  "password": "PasswordPetugas123",
  "role": "petugas",
  "status_aktif": true
}

###

### 2.2 Buat user petugas 02
POST {{baseUrl}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_lengkap": "Petugas Parkir",
  "username": "petugas02",
  "password": "PasswordPetugas123",
  "role": "petugas",
  "status_aktif": true
}

###

### 2.3 Lihat semua user
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

###

### 2.4 Lihat user berdasarkan ID
GET {{baseUrl}}/users/3
Authorization: Bearer {{token}}

###

### 2.5 Update data user
PATCH {{baseUrl}}/users/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_lengkap": "Petugas Parkir Updated"
}

###

### 2.6 Nonaktifkan user
PATCH {{baseUrl}}/users/3/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status_aktif": false
}

###

### 2.7 Hapus user permanen
DELETE {{baseUrl}}/users/3
Authorization: Bearer {{token}}

###

### ==========================================
### 3. CRUD JENIS KENDARAAN
### ==========================================

### 3.1 Lihat semua jenis kendaraan
GET {{baseUrl}}/jenis-kendaraan
Authorization: Bearer {{token}}

###

### 3.2 Tambah jenis kendaraan - Motor
POST {{baseUrl}}/jenis-kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_jenis": "Motor"
}

###

### 3.3 Tambah jenis kendaraan - Mobil
POST {{baseUrl}}/jenis-kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_jenis": "Mobil"
}

###

### 3.4 Lihat jenis kendaraan berdasarkan ID
GET {{baseUrl}}/jenis-kendaraan/1
Authorization: Bearer {{token}}

###

### 3.5 Update jenis kendaraan
PATCH {{baseUrl}}/jenis-kendaraan/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_jenis": "Sepeda Motor"
}

###

DELETE {{baseUrl}}/jenis-kendaraan/1
Authorization: Bearer {{token}}

### ==========================================
### 4. CRUD TARIF
### ==========================================

### 4.1 Lihat semua tarif
GET {{baseUrl}}/tarif
Authorization: Bearer {{token}}

###

### 4.2 Lihat tarif berdasarkan ID
GET {{baseUrl}}/tarif/2
Authorization: Bearer {{token}}

###

### 4.3 Tambah tarif kendaraan
POST {{baseUrl}}/tarif
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_jenis": 3,
  "tarif_per_jam": 3000
}

###

### 4.4 Update tarif kendaraan
PATCH {{baseUrl}}/tarif/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tarif_per_jam": 4000
}

###

### 4.5 Tes tarif dengan ID jenis kendaraan tidak valid
POST {{baseUrl}}/tarif
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_jenis": 999999,
  "tarif_per_jam": 3000
}

###

### 4.6 Tes tarif duplikat untuk jenis kendaraan yang sama
POST {{baseUrl}}/tarif
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id_jenis": 3,
  "tarif_per_jam": 5000
}

###

### 4.7 Hapus tarif kendaraan
DELETE {{baseUrl}}/tarif/2
Authorization: Bearer {{token}}

###

### 4.8 Hapus jenis kendaraan
DELETE {{baseUrl}}/jenis-kendaraan/3
Authorization: Bearer {{token}}

### ==========================================
### 5. CRUD KENDARAAN
### ==========================================

### 5.1 Lihat semua kendaraan
GET {{baseUrl}}/kendaraan
Authorization: Bearer {{token}}

###

### 5.2 Tambah kendaraan
POST {{baseUrl}}/kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plat_nomor": "B 1234 ABC",
  "id_jenis":2,
  "warna": "Hitam",
  "pemilik": "Verdi"
}

###

### 5.3 Tambah kendaraan - Mobil
POST {{baseUrl}}/kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plat_nomor": "B 5678 XYZ",
  "id_jenis": 2,
  "warna": "Putih",
  "pemilik": "Budi"
}

###

### 5.4 Lihat kendaraan berdasarkan ID
GET {{baseUrl}}/kendaraan/3
Authorization: Bearer {{token}}

###

### 5.5 Update data kendaraan
PATCH {{baseUrl}}/kendaraan/3
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plat_nomor": "B 1234 ABC",
  "warna": "Merah",
  "pemilik": "Verdi Updated"
}

###

### 5.6 Tes plat nomor duplikat
POST {{baseUrl}}/kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plat_nomor": "B 1234 ABC",
  "id_jenis": 3,
  "warna": "Hitam",
  "pemilik": "Pengujian"
}

###

### 5.7 Tes ID jenis kendaraan tidak valid
POST {{baseUrl}}/kendaraan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "plat_nomor": "B 9999 TEST",
  "id_jenis": 999999,
  "warna": "Hitam",
  "pemilik": "Pengujian"
}

###

### 5.8 Hapus kendaraan berdasarkan ID
DELETE {{baseUrl}}/kendaraan/3
Authorization: Bearer {{token}}

### ==========================================
### 6. AREA PARKIR
### ==========================================

### GET ALL AREA
GET {{baseUrl}}/area-parkir
Authorization: Bearer {{token}}


### CREATE AREA
POST {{baseUrl}}/area-parkir
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_area": "Area Lantai 1",
  "kapasitas": 20
}


### CREATE AREA 2
POST {{baseUrl}}/area-parkir
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_area": "Area Lantai 2",
  "kapasitas": 30
}


### GET DETAIL AREA
GET {{baseUrl}}/area-parkir/1
Authorization: Bearer {{token}}


### UPDATE AREA
PATCH {{baseUrl}}/area-parkir/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nama_area": "Area Motor",
  "kapasitas": 25
}


### TEST KAPASITAS DI BAWAH TERISI
PATCH {{baseUrl}}/area-parkir/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "kapasitas": 0
}


### TEST TERISI TIDAK BOLEH DIEDIT
PATCH {{baseUrl}}/area-parkir/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "terisi": 10
}


### SOFT DELETE / NONAKTIFKAN
PATCH {{baseUrl}}/area-parkir/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status_aktif": false
}


### AKTIFKAN KEMBALI
PATCH {{baseUrl}}/area-parkir/1/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status_aktif": true
}


### HARD DELETE TANPA KONFIRMASI YANG BENAR
DELETE {{baseUrl}}/area-parkir/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "konfirmasi": "HAPUS"
}


### HARD DELETE DENGAN KONFIRMASI
DELETE {{baseUrl}}/area-parkir/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "konfirmasi": "HAPUS_PERMANEN"
}